NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Wartosci przykladowe. Wygeneruj nowe sekrety przed uruchomieniem.
POSTGRES_DB=strona_db
POSTGRES_USER=strona_user
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql://strona_user:replace-with-random-hex-password@postgres:5432/strona_db
DATABASE_POOL_MAX=10
APP_URL=https://profil-ciala.jtk.ovh
VIDEO_STORAGE_PATH=/data/videos
VIDEO_STORAGE_HOST_PATH=./data/videos
P24_ENABLED=false
P24_ENV=sandbox
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
